{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "assets/facade.d.ts"]
}
