{
  "name": "@zakza/dsh-dwf",
  "version": "0.1.0",
  "description": "Deterministic dynamic-workflow engine for DeepSeek Harness: TS-facade compiler, replay journal, deterministic guest sandbox, actor subagents, dwf workflow tools",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/engine-entry.d.ts",
      "default": "./lib/engine-entry.js"
    },
    "./types": "./src/types/index.d.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "workflow",
    "dynamic-workflow",
    "agent",
    "orchestration",
    "subagent",
    "journal",
    "sandbox"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Achi-Migo/dsh-dwf.git"
  },
  "homepage": "https://github.com/Achi-Migo/dsh-dwf#readme",
  "bugs": {
    "url": "https://github.com/Achi-Migo/dsh-dwf/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-ptc-runtime": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-working-directory": "*",
    "@deepseek-ai/dsh-workflow": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-ptc-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    },
    "@deepseek-ai/dsh-workflow": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}